        "name": "Coptis (Huang Lian)",
        "type": "Herb",
        "herb_attributes": {
          "scientific_name": "Coptis chinensis Franch.; Coptis deltoidea C.Y. Cheng et Hsiao; Coptis teeta Wall.",
          "nature": "Cold",
          "flavor": "Bitter",
          "meridians": [
            "Heart channel",
            "Liver channel",
            "Stomach channel",
            "Large Intestine channel"
          ],
          "dosage": "Internal use: decoction 1.5–3 g; powdered 0.3–0.6 g each time; or used in pills and powders. External use: appropriate amount, ground to powder and applied as a poultice; or decoct for washing; or make into an ointment; or soak in juice for use.",
          "preparation_method": "Slice and dry in shade; stir-fry until surface deep yellow (stir-fried Coptis); ginger-processed (spray with fresh ginger juice then stir-fry); Evodia-processed (soak in Evodia decoction then stir-fry); wine-processed (mix with yellow rice wine then stir-fry).",
          "contraindications": "Use with caution in stomach deficiency with nausea and vomiting, spleen deficiency with diarrhea, and early morning kidney leakage."
        }
