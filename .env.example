MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

JIMENG_AK=
JIMENG_SK=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Used by docker-compose.yml (format: user/password)
NEO4J_AUTH=
# Private Neo4j helper text (optional docs + progress bar label)
NEO4J_CYPHER_PROGRESS_DESC=
NEO4J_RUN_CYPHER_DOC=
NEO4J_RUN_MULTIPLE_CYPHER_DOC=
NEO4J_IMPORT_BATCH_SIZE=

# Private TCM Neo4j import schema (required for create_neo4j_database/)
TCM_NEO4J_PROJECT=
TCM_IMPORT_ENTITY_LABELS=
TCM_IMPORT_ATTRIBUTE_KEYS=
# JSON object: {"REL_TYPE": ["SourceLabel", "TargetLabel"], ...}
TCM_IMPORT_RELATION_SCHEMA=
TCM_IMPORT_PROJECT_INFO=

# Full graph metadata JSON (labels / relationships / triples). Required at runtime.
TCM_METADATA=

EMBEDDING_MODEL_PATH=

HERBS_BASE_URL=
HERBS_LIST_URL=
FORMULAS_LIST_URL=
CRAWLER_USER_AGENT=

# Private crawler selectors / concurrency
CRAWLER_CONTENT_SELECTOR=
CRAWLER_LIST_LINK_SELECTOR=
CRAWLER_DETAIL_REMOVE_SELECTORS=
CRAWLER_DETAIL_UNWRAP_SELECTORS=
CRAWLER_DETAIL_TITLE_SELECTOR=
CRAWLER_BATCH_SIZE=
CRAWLER_MAX_RETRIES=
CRAWLER_TRANSLATE_WORKERS=
CRAWLER_DETAIL_WORKERS=
CRAWLER_REQUEST_DELAY_MIN=
CRAWLER_REQUEST_DELAY_MAX=
CRAWLER_CHUNK_SIZE=

# Private crawler translation prompts (required for clawler/)
CRAWLER_HERBS_LIST_PROMPT=
CRAWLER_FORMULAS_LIST_PROMPT=
CRAWLER_HERBS_DETAIL_PROMPT=
CRAWLER_FORMULAS_DETAIL_PROMPT=

# Private knowledge-graph extraction (required for extract_information/)
# Prompt must include {format_instructions} and {text}.
KG_EXTRACTION_PROMPT=
# Optional private project notes / data-layout docs (not loaded into the LLM)
KG_EXTRACTION_PROJECT_INFO=
# JSON schema used to build extraction models at runtime
KG_EXTRACTION_SCHEMA=
# Instruction text stored in finetune JSONL/JSON records
KG_FINETUNE_INSTRUCTION=
KG_TRANSLATE_PROMPT=
KG_EXTRACT_WORKERS=
KG_EXTRACT_MAX_RETRIES=

# Private langgraph prompts (required for langgraph_nodes/)
ZHONGYI_INTENT_PROMPT=
ENTITY_EXTRACTION_PROMPT=
CYPHER_GENERATION_PROMPT=
NEO4J_ANSWER_PROMPT=
MAX_CYPHER_CHECKS=
HISTORY_NUM=6
LLM_DIRECT_OUT_SYSTEM_PROMPT=

# Private entity linking / Cypher guards (JSON)
# {"Label":{"state_key":"user_input_...","attr":"..."}}
ENTITY_LABEL_CONFIG=
# {"user_input_...":"matched_..."}
ENTITY_INPUT_TO_MATCHED_KEY=
# {"matched_...":"Label"}
ENTITY_MATCHED_KEY_TO_LABEL=
ENTITY_MATCH_TOP_K=
ENTITY_MATCH_THRESHOLD=
ENTITY_NEAR_DUPLICATE_THRESHOLD=
# JSON list of Cypher write keywords to reject
CYPHER_WRITE_KEYWORDS=

# FastAPI server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_TITLE=TCM Knowledge Graph System
FASTAPI_DESCRIPTION=TCM knowledge graph based on FastAPI and LangGraph
FASTAPI_ERROR_OUTPUT=System error, please try again!
FASTAPI_HEALTH_MESSAGE=TCM Knowledge Graph System is running normally
# JSON list of AgentState keys logged at INFO
FASTAPI_KEY_STATE_FIELDS=

# FastAPI client / tests
API_BASE_URL=http://localhost:8000
API_TEST_USER_ID=user-123
API_HEALTH_TIMEOUT=10
API_PROCESS_TIMEOUT=120
API_MISSING_FIELD_TIMEOUT=10

# Logging (console + logs/fastapi.log, logs/streamlit.log)
LOG_LEVEL=INFO

# Streamlit frontend (bash start.sh runs API + UI); calls the API at API_BASE_URL
STREAMLIT_PORT=8501
STREAMLIT_TAGLINE=
# JSON list of example questions
STREAMLIT_EXAMPLE_QUESTIONS=
# JSON list of sidebar steps
STREAMLIT_SIDEBAR_HOWTO=
STREAMLIT_DISCLAIMER=
STREAMLIT_INPUT_PLACEHOLDER=Ask about a herb, formula, symptom, or disease…
STREAMLIT_EMPTY_HINT=Try an example, or type your own question below.
STREAMLIT_SPINNER_TEXT=Consulting the knowledge graph…
# Default for the "Stream thinking" sidebar toggle (true/false)
STREAMLIT_STREAM_DEFAULT=true
